---
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/500-italic.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { site, google } from '../data/site';

interface Props {
  title: string;
  description: string;
  crumbs?: { label: string; href?: string }[];
  schema?: object[];
  noindex?: boolean;
}
const { title, description, crumbs = [], schema = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL('/og.jpg', site.url).href;
const a = site.address;

const legalService = {
  '@context': 'https://schema.org',
  '@type': 'LegalService',
  '@id': `${site.url}/#firm`,
  name: site.name,
  legalName: site.legalName,
  url: `${site.url}/`,
  logo: `${site.url}/logo.png`,
  image: ogImage,
  telephone: '+1-404-998-2992',
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '2330 Scenic Hwy S',
    addressLocality: a.city,
    addressRegion: a.state,
    postalCode: a.zip,
    addressCountry: 'US',
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '08:30',
      closes: '17:00',
    },
  ],
  areaServed: [
    { '@type': 'City', name: 'Snellville, Georgia' },
    { '@type': 'AdministrativeArea', name: 'Gwinnett County, Georgia' },
    { '@type': 'City', name: 'Lawrenceville, Georgia' },
    { '@type': 'City', name: 'Conyers, Georgia' },
  ],
  knowsAbout: ['Criminal defense', 'DUI defense', 'Drug charges', 'Assault charges', 'Personal injury', 'Car accidents', 'Premises liability'],
  founder: { '@id': `${site.url}/about/#attorney` },
  sameAs: [...site.social.map((s) => s.href), google.profileUrl],
};

const breadcrumb = crumbs.length && {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [{ label: 'Home', href: '/' }, ...crumbs].map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    item: new URL(c.href ?? Astro.url.pathname, site.url).href,
  })),
};
const blocks = [legalService, breadcrumb, ...schema].filter(Boolean);
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#101c2c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {blocks.map((b) => <script type="application/ld+json" set:html={JSON.stringify(b)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to main content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <div class="callbar">
      <a href={site.phoneHref}><Icon name="phone" /> Call now</a>
      <a href="#consultation">Consultation</a>
    </div>
    <script>
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          }),
        { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
