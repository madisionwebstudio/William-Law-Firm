---
interface Props { name: 'arrow' | 'phone' | 'pin' | 'chev' | 'mail' | 'star' | 'menu' | 'close'; class?: string }
const { name, class: cls } = Astro.props;
const paths: Record<string, string> = {
  arrow: '<path d="M3 12h17M14 6l6 6-6 6"/>',
  phone: '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1Z"/>',
  pin: '<path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.500C5 14.800 12 21 12 21Z"/><circle cx="12" cy="9.500" r="2.500"/>',
  chev: '<path d="M5 9l7 7 7-7"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="1"/><path d="M3 7l9 6 9-6"/>',
  menu: '<path d="M3 7h18M3 12h18M3 17h18"/>',
  close: '<path d="M5 5l14 14M19 5L5 19"/>',
};
---
{name === 'star' ? (
  <svg class={cls} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.500l2.950 6.200 6.800.850-5 4.700 1.300 6.750L12 17.700 5.950 21l1.300-6.750-5-4.700 6.800-.850L12 2.500Z"/></svg>
) : (
  <svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.500" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={paths[name]} />
)}
